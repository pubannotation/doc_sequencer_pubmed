# Environment variables for doc_sequencer_pubmed

# CRITICAL DEPENDENCIES - Required for service startup
# The service will not start without these being properly configured

# Required: NCBI API key for PubMed/PMC access
# Get your key from: https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=your_ncbi_api_key_here

# Required: Redis server must be running and accessible
# Default: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Throttling configuration
# Delay in seconds between upstream API requests (default: 0.2)
# With NCBI API key: up to 10 req/sec allowed, 0.2s = 5 req/sec (safe with buffer)
THROTTLE_DELAY=0.2

# Queue size limit (default: 100)
# Maximum number of requests that can be queued during traffic bursts
# When full, returns HTTP 429 with Retry-After header
QUEUE_MAX_SIZE=100

# Redis pool configuration (optional)
REDIS_POOL_SIZE=5

# Rack environment
RACK_ENV=development

# For production deployment
# RACK_ENV=production

# Logging configuration
# LOG_LEVEL options: DEBUG, INFO, WARN, ERROR, FATAL (default: INFO)
LOG_LEVEL=INFO
# LOG_OUTPUT options: STDOUT, file path (default: STDOUT)
LOG_OUTPUT=STDOUT
# For production, you might want to log to a file:
# LOG_OUTPUT=logs/app.log